<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/dv_bg">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/top_scrim" />

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo_mark" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/app_name"
            android:textColor="@color/dv_text"
            android:textSize="19sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:maxWidth="220dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/status_ready"
            android:textColor="@color/dv_text"
            android:textSize="13sp"
            android:background="@drawable/bg_status" />
    </LinearLayout>

    <!-- Bottom sheet: home / trip / arrival -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="20dp"
        android:background="@drawable/bg_panel"
        android:elevation="12dp">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/permCard"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_title"
                    android:textColor="@color/dv_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/permBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/perm_body"
                    android:textColor="@color/dv_muted"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />
                <TextView
                    android:id="@+id/permButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/perm_allow"
                    android:textColor="@color/dv_on_accent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/greeting"
                android:textColor="@color/dv_text"
                android:textSize="30sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/greeting_sub"
                android:textColor="@color/dv_muted"
                android:textSize="17sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none"
                android:clipToPadding="false">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/chipFuel" style="@style/DvChip" android:text="@string/chip_fuel" />
                    <TextView android:id="@+id/chipCoffee" style="@style/DvChip" android:text="@string/chip_coffee" />
                    <TextView android:id="@+id/chipFood" style="@style/DvChip" android:text="@string/chip_food" />
                    <TextView android:id="@+id/chipParking" style="@style/DvChip" android:text="@string/chip_parking" />
                    <TextView android:id="@+id/chipCharging" style="@style/DvChip" android:text="@string/chip_charging" />
                    <TextView android:id="@+id/chipMusic" style="@style/DvChip" android:text="@string/chip_music" />
                </LinearLayout>
            </HorizontalScrollView>

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp">
                <View
                    android:id="@+id/micRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:background="@drawable/bg_mic_ring" />
                <ImageView
                    android:id="@+id/btnVoice"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:padding="26dp"
                    android:src="@drawable/ic_mic"
                    android:tint="@color/dv_on_accent"
                    android:background="@drawable/bg_mic"
                    android:elevation="6dp"
                    android:contentDescription="@string/talk_to_fares" />
            </FrameLayout>
            <TextView
                android:id="@+id/tvMicLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/talk_to_fares"
                android:textColor="@color/dv_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ACTIVE TRIP (driving mode) -->
        <LinearLayout
            android:id="@+id/tripContent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card">
                <TextView
                    android:id="@+id/tvArrow"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="↑"
                    android:textColor="@color/dv_accent"
                    android:textSize="46sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvNextDistance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dv_text"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvNextInstruction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textColor="@color/dv_text"
                        android:textSize="18sp" />
                    <TextView
                        android:id="@+id/tvRoad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/dv_muted"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <LinearLayout style="@style/DvStat">
                    <TextView android:id="@+id/tvStatArrival" style="@style/DvStatValue" />
                    <TextView style="@style/DvStatLabel" android:text="@string/stat_arrival" />
                </LinearLayout>
                <LinearLayout style="@style/DvStat">
                    <TextView android:id="@+id/tvStatRemaining" style="@style/DvStatValue" />
                    <TextView style="@style/DvStatLabel" android:text="@string/stat_remaining" />
                </LinearLayout>
                <LinearLayout style="@style/DvStat">
                    <TextView android:id="@+id/tvStatTime" style="@style/DvStatValue" />
                    <TextView style="@style/DvStatLabel" android:text="@string/stat_time" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvTripDestination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/dv_text"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvTripStops"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/dv_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/btnAddStop"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/add_stop"
                    android:textColor="@color/dv_text"
                    android:textSize="15sp"
                    android:background="@drawable/bg_btn_secondary" />
                <ImageView
                    android:id="@+id/btnVoiceTrip"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:padding="20dp"
                    android:src="@drawable/ic_mic"
                    android:tint="@color/dv_on_accent"
                    android:background="@drawable/bg_mic"
                    android:contentDescription="@string/talk_to_fares" />
                <TextView
                    android:id="@+id/btnCancelTrip"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/cancel_trip"
                    android:textColor="@color/dv_bad"
                    android:textSize="15sp"
                    android:background="@drawable/bg_btn_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ARRIVAL -->
        <LinearLayout
            android:id="@+id/arrivalContent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/arrived_title"
                android:textColor="@color/dv_good"
                android:textSize="26sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvArrivedDestination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/dv_text"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/tvArrivedStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/dv_muted"
                android:textSize="16sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnNewTrip"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/new_trip"
                    android:textColor="@color/dv_on_accent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary" />
                <TextView
                    android:id="@+id/btnCloseArrival"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:text="@string/close"
                    android:textColor="@color/dv_text"
                    android:textSize="16sp"
                    android:background="@drawable/bg_btn_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Voice overlay -->
    <LinearLayout
        android:id="@+id/voiceOverlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@color/dv_scrim">
        <TextView
            android:id="@+id/tvVoiceState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_listening"
            android:textColor="@color/dv_text"
            android:textSize="32sp"
            android:textStyle="bold" />
        <com.drivevoice.mvp.VoiceWaveView
            android:id="@+id/waveView"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp" />
        <TextView
            android:id="@+id/tvTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center"
            android:text="@string/voice_hint"
            android:textColor="@color/dv_muted"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/btnCancelVoice"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:minWidth="140dp"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/cancel"
            android:textColor="@color/dv_text"
            android:textSize="17sp"
            android:background="@drawable/bg_btn_secondary" />
    </LinearLayout>
</FrameLayout>
